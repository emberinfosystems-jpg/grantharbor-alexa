{
  "name": "grantguard-desktop",
  "version": "0.1.0",
  "description": "GrantHarbor — government grant discovery, deadline and application tracking for small businesses and nonprofits (Electron/React, local-first)",
  "main": "./out/main/index.js",
  "author": "Ember Information Systems",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "//mobile": "MOBILE MUST use --mode mobile so .env.mobile (VITE_DB_BACKEND=local) is baked in -> LOCAL_MODE hides the Pro/Upgrade + Discover surfaces the phone can't deliver. Building without it ships the pocketbase/desktop nav and Amazon rejects it (in-app IAP price listing). outDir=dist-web is pinned in vite.renderer.config.mjs.",
    "build:mobile": "vite build --config vite.renderer.config.mjs --mode mobile",
    "apk": "npm run build:mobile && npx cap sync android && android\\gradlew.bat -p android assembleRelease",
    "package": "electron-vite build && electron-packager . GrantHarbor --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --icon=build-assets/icon.ico --extra-resource=pocketbase/pocketbase.exe --extra-resource=pocketbase/pb_template --ignore=\"^/node_modules$\" --ignore=\"^/src$\" --ignore=\"^/dist$\" --ignore=\"^/pocketbase$\" --ignore=\"^/tools$\" --ignore=\"^/reference$\" --ignore=\"^/build-assets$\" --ignore=\"^/pb_data$\" --ignore=\"BUILD_PLAN\\.md\" --ignore=\"DIFFERENTIATORS\\.md\" --ignore=\"\\.log\" --ignore=\"dev_pid\\.txt\" --ignore=\"^/tsconfig.*\\.json$\" --ignore=\"^/electron\\.vite\\.config\\.ts$\" --ignore=\"^/vite\\.renderer\\.config\\.mjs$\" --ignore=\"^/postcss\\.config\\.cjs$\" --ignore=\"^/tailwind\\.config\\.cjs$\" --ignore=\"^/\\.env$\""
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^28.3.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.25",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  }
}
